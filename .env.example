# ─────────────────────────────────────────────────────────────
# SUNAT Bot V2 - variables de entorno de ejemplo
# Copie este archivo como .env y complete sus credenciales.
# ─────────────────────────────────────────────────────────────

# Credenciales SUNAT (obligatorio)
SUNAT_RUC=20000000001
SUNAT_USUARIO=USUARIO_SOL
SUNAT_CLAVE=CLAVE_SOL

# Archivo Excel y carpetas
EXCEL_FILE=comprobantes.xlsx
UPLOAD_DIR=./uploads
OUTPUT_DIR=./descargas_sunat
MAX_UPLOAD_MB=20

# Opciones de descarga
DESCARGAR_PDF=true
DESCARGAR_XML=true

# Navegador (login SUNAT)
SUNAT_HEADLESS=true
SUNAT_SLOW_MO=0
SUNAT_TIMEOUT_MS=45000
SUNAT_LOGIN_INTENTOS=2
SUNAT_LOGIN_ESPERA_SEG=10

# Concurrencia y reintentos
MAX_WORKERS=3
MAX_REINTENTOS_INMEDIATOS=2
DELAY_REINTENTO=2.0
PAUSA_MIN_ENTRE_CPE=0.8
PAUSA_MAX_ENTRE_CPE=1.5
PAUSA_MIN_ENTRE_ARCHIVOS=0.5
PAUSA_MAX_ENTRE_ARCHIVOS=1.2
ESPERA_BASE_RONDA_SEG=60
FACTOR_BACKOFF=1.5
ESPERA_MAX_RONDA_SEG=300
MAX_RONDAS_ARCHIVOS=10

# Google Drive (opcional)
GOOGLE_CREDENTIALS_PATH=service_account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Produccion en subdirectorio (debe coincidir con Google Cloud Console):
# GOOGLE_REDIRECT_URI=https://servicios.algoritmojuridico.com/downloadpdf/auth/google/callback

# Correo electrónico (opcional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_DESTINATARIO=

# Base de datos (por defecto SQLite local)
DATABASE_URL=sqlite:///./test.db

# API
# En produccion limitar al dominio del frontend:
# CORS_ORIGINS=https://servicios.algoritmojuridico.com
CORS_ORIGINS=*
UVICORN_RELOAD=false

# Prefijo publico si la app se monta en un subdirectorio.
# Dejar vacio si se publica en la raiz del dominio.
# Ejemplo: ROOT_PATH=/downloadpdf
ROOT_PATH=
